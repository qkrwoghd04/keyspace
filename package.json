{
  "name": "keyspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/main.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/main.mjs",
    "start": "node dist-server/main.mjs",
    "check": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-challenge.ts",
    "db:backup": "node scripts/backup-db.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.2",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "vite": "^7.1.3",
    "vitest": "^5.0.0"
  }
}
